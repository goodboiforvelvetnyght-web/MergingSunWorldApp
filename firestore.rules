rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /worlds/main { allow read: if true; allow write: if false; }
    match /characters/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if false;
      match /journeys/{journey} {
        allow read: if signedIn() && (request.auth.uid == uid || admin());
        allow write: if false;
      }
    }
    match /worldBackups/{version} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
