rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (request.auth.token.get('admin', false) == true ||
        (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role == 'admin'));
    }
    function ownerOrAdmin(uid) { return signedIn() && (request.auth.uid == uid || admin()); }
    match /events/{event} { allow read: if resource.data.published == true || admin(); allow write: if false; }
    match /registrationDrafts/{event} { allow read: if admin(); allow write: if false; }
    match /registrationSheets/{event} { allow read: if admin(); allow write: if false; }
    match /events/{event}/registration/{config} { allow read: if admin() || get(/databases/$(database)/documents/events/$(event)).data.published == true; allow write: if false; }
    match /events/{event}/registrations/{registration} { allow read: if admin(); allow write: if false; }
    match /events/{event}/registrationVersions/{version} { allow read: if admin(); allow write: if false; }
    match /worlds/main { allow read: if true; allow write: if false; }
    // Character records include real names and portraits: only the owner and admins may read them.
    match /characters/{uid} {
      allow read: if ownerOrAdmin(uid);
      allow write: if false;
      match /journeys/{journey} { allow read: if ownerOrAdmin(uid); allow write: if false; }
      match /incarnations/{generation} {
        allow read: if ownerOrAdmin(uid);
        allow write: if false;
        match /journeys/{journey} { allow read: if ownerOrAdmin(uid); allow write: if false; }
      }
    }
    match /characterApplications/{uid} {
      allow read: if ownerOrAdmin(uid);
      allow write: if false;
      match /history/{id} { allow read: if ownerOrAdmin(uid); allow write: if false; }
    }
    match /population/main { allow read: if true; allow write: if false; }
    match /mapUploads/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow write: if false;
    }
    match /imageAssets/{id} { allow read: if admin(); allow write: if false; }
    match /adminRoles/{uid} { allow read: if ownerOrAdmin(uid); allow write: if false; }
    match /adminInvitations/{invitation} { allow read: if admin(); allow write: if false; }
    match /worldBackups/{version} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
