{
  "name": "merging-sun-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:firebase": "firebase emulators:exec --project demo-merging-sun --only auth,firestore,functions,storage 'node scripts/test-firebase.mjs'",
    "map:generate": "node scripts/generate-map.mjs",
    "build:backend": "npm --prefix functions run build",
    "emulators": "firebase emulators:start --project demo-merging-sun --only auth,firestore,functions",
    "format": "prettier --write src shared functions/src functions/scripts scripts tests *.ts *.json *.md",
    "test:auth": "firebase emulators:exec --project demo-merging-sun --only auth 'node scripts/test-auth.mjs'",
    "deploy": "npm run build && firebase deploy --project mergingsunapp-2 --only firestore:rules,firestore:indexes,functions,hosting,storage",
    "test:connected-ui": "firebase emulators:exec --project demo-merging-sun --only auth,firestore,functions,storage 'node scripts/test-connected-ui.mjs'"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dompurify": "^3.2.0",
    "firebase": "^12.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.34.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
